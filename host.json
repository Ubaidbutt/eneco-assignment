{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "serviceBus": {
      "maxMessageBatchSize": 5,
      "minMessageBatchSize": 1,
      "maxBatchWaitTime": "00:00:05"
    }
  },
  "logging": {
    "logLevel": {
      "default": "Information",
      "Function": "Information"
    }
  }
}
